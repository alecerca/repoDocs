{
  "name": "repodocs",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs && node scripts/sync-adr.mjs",
    "predev": "node scripts/sync-docs.mjs && node scripts/sync-adr.mjs",
    "prebuild": "node scripts/sync-docs.mjs && node scripts/sync-adr.mjs",
    "adr:lint": "node scripts/sync-adr.mjs --lint",
    "webhook:local": "node server/webhook-local.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "smoke": "node scripts/run-smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
