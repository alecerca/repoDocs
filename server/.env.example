# Copiá a server/.env y ajustá. NUNCA commitees este archivo con valores reales.
# En producción estos mismos valores van como "Environment Variables" de la
# plataforma serverless (Vercel → Settings → Environment Variables, o el secreto
# del Worker), no en el repo.

# Secreto del webhook. Lo definís vos:
#  - Gumroad: Settings → Advanced → Webhooks (lo ingresás al crear el webhook).
#  - Lemon Squeezy: se ingresa al crear el webhook (Settings → Webhooks → "+").
ADRP_WEBHOOK_SECRET=cambia-este-secreto-largo-aleatorio

# Clave Ed25519 PRIVADA (hex). Es la línea final de
#   ~/proyectos/repodocs-adr-premium-private.txt
# NUNCA la pongas en un archivo del repo.
ADRP_PRIVATE_KEY_HEX=

# Ids de producto a los que se les emite licencia (separados por coma).
# Gumroad usa el permalink ("repodocs-adr-premium"); Lemon Squeezy el product_id numérico.
ADRP_PRODUCT_IDS=repodocs-adr-premium

# Asientos por licencia (default 1)
ADRP_SEATS=1

# Descomentá para emitir también en compras de prueba (por defecto se ignoran)
# ADRP_ACCEPT_TEST=1

# Email del token al comprador (opcional, vía Resend):
# Crea un API key en https://resend.com → API Keys (gratis).
# ADRP_RESEND_KEY=re_........
# ADRP_RESEND_FROM=repoDocs <ventas@tudominio.com>